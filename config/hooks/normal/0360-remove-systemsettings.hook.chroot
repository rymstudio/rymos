#!/bin/bash
set -e
# systemsettings entra come Recommends di kio6 (dipendenza di Calamares).
# I moduli QML dello slideshow (qml6-module-qtquick, -window) sono nella lista
# pacchetti, quindi l'autoremove toglie solo le librerie KDE rimaste orfane.
apt-get purge -y systemsettings
apt-get autoremove --purge -y
