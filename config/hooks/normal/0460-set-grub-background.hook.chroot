#!/bin/bash
set -e

GRUB_DEFAULT_FILE="/etc/default/grub"
BG_LINE='GRUB_BACKGROUND="/usr/share/images/rymos/gback.png"'

if grep -q "^GRUB_BACKGROUND=" "$GRUB_DEFAULT_FILE"; then
    sed -i "s|^GRUB_BACKGROUND=.*|$BG_LINE|" "$GRUB_DEFAULT_FILE"
elif grep -q "^#GRUB_BACKGROUND=" "$GRUB_DEFAULT_FILE"; then
    sed -i "s|^#GRUB_BACKGROUND=.*|$BG_LINE|" "$GRUB_DEFAULT_FILE"
else
    echo "$BG_LINE" >> "$GRUB_DEFAULT_FILE"
fi
